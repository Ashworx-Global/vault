---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description = 'Daily Bible readings with linked verse pages', canonical } = Astro.props;
const siteUrl = 'https://ashworx-global.github.io/vault';
const pageUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Man of God Daily Readings</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@400;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-primary-700 text-white rounded-lg">Skip to main content</a>
    
    <header class="bg-stone-50 border-b border-stone-200 sticky top-0 z-40">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-8">
            <a href="/" class="flex items-center gap-2" aria-label="Man of God Daily Readings - Home">
              <svg class="w-8 h-8 text-primary-700" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
              </svg>
              <span class="font-serif text-xl font-bold text-stone-900 hidden sm:block">Man of God Daily Readings</span>
            </a>
            
            <div class="hidden md:flex items-center gap-6">
              <a href="/daily" class="text-sm font-medium text-stone-700 hover:text-primary-700 transition-colors">Daily Notes</a>
              <a href="/bible" class="text-sm font-medium text-stone-700 hover:text-primary-700 transition-colors">Verse Pages</a>
              <a href="/tags" class="text-sm font-medium text-stone-700 hover:text-primary-700 transition-colors">Topics</a>
              <a href="/books" class="text-sm font-medium text-stone-700 hover:text-primary-700 transition-colors">Books</a>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <button 
              id="theme-toggle" 
              class="p-2 rounded-lg text-stone-600 hover:bg-stone-200 transition-colors"
              aria-label="Toggle dark mode"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
              </svg>
            </button>
            
            <a 
              href="https://github.com/Ashworx-Global/vault" 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-2 rounded-lg text-stone-600 hover:bg-stone-200 transition-colors"
              aria-label="View on GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="md:hidden py-4 border-t border-stone-200">
          <div class="flex flex-wrap justify-center gap-4 text-sm">
            <a href="/daily" class="font-medium text-stone-700 hover:text-primary-700">Daily Notes</a>
            <a href="/bible" class="font-medium text-stone-700 hover:text-primary-700">Verse Pages</a>
            <a href="/tags" class="font-medium text-stone-700 hover:text-primary-700">Topics</a>
            <a href="/books" class="font-medium text-stone-700 hover:text-primary-700">Books</a>
          </div>
        </div>
      </nav>
    </header>
    
    <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    
    <footer class="bg-stone-50 border-t border-stone-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="font-semibold text-stone-900 mb-3">Man of God Daily Readings</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Daily Bible reading notes with linked verse pages. 
              Harvested from daily reflections using the 
              <a href="https://github.com/lee-royashworth/opencode-skills/tree/main/verse-pages" class="text-primary-700 hover:underline" target="_blank" rel="noopener">verse-pages</a> skill.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-stone-900 mb-3">Navigation</h3>
            <nav class="space-y-2 text-sm">
              <a href="/daily" class="block text-stone-600 hover:text-primary-700">Daily Notes</a>
              <a href="/bible" class="block text-stone-600 hover:text-primary-700">Verse Pages</a>
              <a href="/tags" class="block text-stone-600 hover:text-primary-700">Topics</a>
              <a href="/books" class="block text-stone-600 hover:text-primary-700">Books</a>
            </nav>
          </div>
          <div>
            <h3 class="font-semibold text-stone-900 mb-3">Links</h3>
            <nav class="space-y-2 text-sm">
              <a href="https://github.com/Ashworx-Global/vault" target="_blank" rel="noopener" class="block text-stone-600 hover:text-primary-700">GitHub Repository</a>
              <a href="https://github.com/lee-royashworth/opencode-skills" target="_blank" rel="noopener" class="block text-stone-600 hover:text-primary-700">OpenCode Skills</a>
            </nav>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-stone-200 text-center text-sm text-stone-500">
          <p>&copy; {new Date().getFullYear()} Man of God Daily Readings. Built with Astro & Tailwind CSS.</p>
        </div>
      </div>
    </footer>
    
    <script>
      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      
      function applyTheme(theme) {
        if (theme === 'dark') {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
      }
      
      // Check for saved theme or system preference
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      applyTheme(savedTheme || (prefersDark ? 'dark' : 'light'));
      
      themeToggle.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
      
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>