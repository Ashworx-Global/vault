---
import Layout from '../layouts/Layout.astro';
---

const tagCounts = {
  'restoration': 2, 'covenant': 3, 'messiah': 4, 'peace': 4, 'providence': 5,
  'suffering': 2, 'aging': 3, 'grace': 4, 'judgment': 4, 'resurrection': 3,
  'faith': 5, 'scripture': 1, 'praise': 1, 'dependence': 4, 'unexpected-opportunities': 1,
  'visions': 2, 'revelation': 2, 'sovereignty': 3, 'justice': 3, 'mercy': 2,
  'fasting': 2, 'heart': 2, 'obedience': 2, 'roman-citizenship': 2, 'courage': 3,
  'persecution': 2, 'conspiracy': 3, 'divine-protection': 3, 'righteousness': 2,
  'compassion': 2, 'blessing': 3, 'prayer': 1, 'zerubbabel': 2, 'david': 1,
  'spirit': 2, 'power': 1, 'might': 1, 'weakness': 2, 'trust': 1,
  'divine-enablement': 1, 'human-limitation': 1, 'faithfulness': 2, 'mountain': 1,
  'obstacles': 1, 'daily-struggles': 1,
};

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const tagsHtml = sortedTags.map(([tag, count]) => 
  '<a href="/tags/' + tag + '" class="bg-white rounded-xl p-5 shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">' +
  '<div class="flex items-center justify-between mb-2">' +
  '<span class="font-semibold text-stone-900 group-hover:text-primary-700 transition-colors">#' + tag + '</span>' +
  '<span class="text-xs text-stone-500 bg-stone-100 px-2 py-0.5 rounded-full">' + count + '</span>' +
  '</div>' +
  '<p class="text-sm text-stone-600">Appears in ' + count + ' ' + (count === 1 ? 'page' : 'pages') + '</p>' +
  '</a>'
).join("");
---

<Layout title="Topics" description="Browse all topics and themes across daily notes and verse pages">
  <div class="animate-fade-in">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-900 mb-3">Topics & Themes</h1>
      <p class="text-stone-600 text-lg max-w-2xl">Explore content by theological themes and topics extracted from Scripture passages and personal reflections.</p>
    </header>

    <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
      {tagsHtml}
    </div>
  </div>
</Layout>