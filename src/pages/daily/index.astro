---
import Layout from '../../layouts/Layout.astro';
import { getDailyNotes } from '../../lib/vault';
---

const dailyNotes = await getDailyNotes();
const sortedNotes = dailyNotes.sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Daily Notes" description="Browse all daily Bible reading notes">
  <div class="animate-fade-in">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-900 mb-3">Daily Notes</h1>
      <p class="text-stone-600 text-lg max-w-2xl">Chronological daily Bible reading reflections with linked verse pages and thematic tags.</p>
    </header>

    <div class="space-y-6">
      {sortedNotes.map((note, i) => {
        const delay = i * 50;
        return (
          <article class="bg-white rounded-xl shadow-sm border border-stone-200 hover:shadow-md transition-all overflow-hidden animate-slide-up" style={'animation-delay: ' + delay + 'ms'}>
            <div class="p-6 md:p-8">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
                <div>
                  <time class="text-sm text-primary-700 font-medium" datetime={note.date}>
                    {new Date(note.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <h2 class="mt-2 text-2xl md:text-3xl font-bold text-stone-900">
                    <a href={'/daily/' + note.slug.split('/')[1]} class="hover:text-primary-700 transition-colors">
                      {note.title}
                    </a>
                  </h2>
                </div>
                <div class="flex flex-wrap gap-2">
                  {note.passages.map(passage => (
                    <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full font-medium border border-primary-100">{passage}</span>
                  ))}
                </div>
              </div>
              
              <div class="prose prose-sm prose-stone max-w-none text-stone-700 mb-6">
                {note.content.replace(/<[^>]*>/g, '').slice(0, 300)}...
              </div>
              
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs text-stone-500">Topics:</span>
                <div class="flex flex-wrap gap-2">
                  {(note.frontmatter.tags || []).map(tag => (
                    <a href={'/tags/' + tag} class="px-3 py-1 bg-stone-100 text-stone-700 text-sm rounded-full hover:bg-primary-50 hover:text-primary-700 transition-colors border border-stone-200">#{tag}</a>
                  ))}
                </div>
              </div>
              
              <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
                <a href={'/daily/' + note.slug.split('/')[1]} class="text-primary-700 hover:text-primary-800 font-medium text-sm flex items-center gap-1">
                  Read full note <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
                <span class="text-xs text-stone-400">{note.versePages.length} verse pages</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {sortedNotes.length === 0 && (
      <div class="text-center py-16">
        <svg class="w-16 h-16 mx-auto text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <h2 class="text-xl text-stone-600 mb-2">No daily notes yet</h2>
        <p class="text-stone-500">Start adding daily reading notes to see them here.</p>
      </div>
    )}
  </div>
</Layout>