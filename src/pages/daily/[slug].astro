---
import Layout from '../../layouts/Layout.astro';
import { dailyNotes } from '../../data/dailyNotes';
---

export async function getStaticPaths() {
  return dailyNotes.map(note => ({
    params: { slug: note.slug },
    props: { note },
  }));
}
---

<Layout title={Astro.props.note.title} description={Astro.props.note.frontmatter.description || 'Daily reading: ' + Astro.props.note.title} canonical={'/daily/' + Astro.props.note.slug}>
  <article class="animate-fade-in max-w-4xl mx-auto">
    <header class="mb-8 pb-6 border-b border-stone-200">
      <time class="text-sm text-primary-700 font-medium" datetime={Astro.props.note.date}>
        {new Date(Astro.props.note.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold font-serif text-stone-900 mb-4">{Astro.props.note.title}</h1>
      
      <div class="flex flex-wrap gap-3 mb-4">
        {Astro.props.note.passages.map(passage => (
          <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full font-medium border border-primary-100">{passage}</span>
        ))}
      </div>
      
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs text-stone-500">Topics:</span>
        <div class="flex flex-wrap gap-2">
          {(Astro.props.note.frontmatter.tags || []).map(tag => (
            <a href="/tags/" + tag class="px-3 py-1 bg-stone-100 text-stone-700 text-sm rounded-full hover:bg-primary-50 hover:text-primary-700 transition-colors border border-stone-200">#{tag}</a>
          ))}
        </div>
      </div>
    </header>

    <div class="prose prose-custom prose-stone max-w-none mb-12">
      <div class="markdown-body" set:html={Astro.props.note.content} />
    </div>

    {Astro.props.note.versePages.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-stone-900 mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          Harvested Verse Pages
        </h2>
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {Astro.props.note.versePages.map(verseRef => (
            <article class="bg-white rounded-xl p-5 shadow-sm border border-stone-200 hover:shadow-md transition-all">
              <h3 class="font-semibold text-stone-900 mb-2">
                <a href="/bible/" + verseRef.toLowerCase().replace(/ /g, '-').replace(/–/g, '-').replace(/:/g, '') class="hover:text-primary-700 transition-colors">
                  {verseRef}
                </a>
              </h3>
            </article>
          ))}
        </div>
      </section>
    )}

    <footer class="pt-6 border-t border-stone-200">
      <nav class="flex flex-wrap gap-4 text-sm text-stone-600">
        <a href="/daily" class="hover:text-primary-700 transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Back to Daily Notes
        </a>
        <a href="/bible" class="hover:text-primary-700 transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477-4.5 1.253"/></svg>
          Browse Verse Pages
        </a>
      </nav>
    </footer>
  </article>
</Layout>