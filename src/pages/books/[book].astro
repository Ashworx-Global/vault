---
import Layout from '../../layouts/Layout.astro';
import { getBookPageData } from '../../utils/bookPage';
---

export async function getStaticPaths() {
  const { allBooks } = await import('../../data/bookChapters');
  return allBooks.map(book => ({ params: { book } }));
}

const { book } = Astro.props;
const { title, description, totalPassages, totalChapters, navHtml, chaptersHtml } = getBookPageData(book);
---

<Layout title={title} description={description}>
  <div class="animate-fade-in">
    <header class="mb-10">
      <nav class="flex items-center gap-2 text-sm text-stone-500 mb-4" aria-label="Breadcrumb">
        <a href="/books" class="hover:text-primary-700 transition-colors">Books</a>
        <span>/</span>
        <span class="text-stone-900 font-medium">{book}</span>
      </nav>
      
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-900">{book}</h1>
          <p class="text-stone-600 mt-2">{totalPassages} passages across {totalChapters} chapters</p>
        </div>
        <div class="flex gap-2" set:html={navHtml}></div>
      </div>
    </header>

    <div class="space-y-6">
      <span set:html={chaptersHtml}></span>
    </div>
  </div>
</Layout>