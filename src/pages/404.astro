---
import Layout from './layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist">
  <div class="min-h-[60vh] flex items-center justify-center text-center animate-fade-in">
    <div class="max-w-md mx-auto px-4">
      <svg class="w-24 h-24 mx-auto text-stone-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <h1 class="text-4xl font-bold text-stone-900 mb-3">404</h1>
      <h2 class="text-xl text-stone-600 mb-4">Page Not Found</h2>
      <p class="text-stone-500 mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-primary-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors">
          Go Home
        </a>
        <a href="/daily" class="bg-stone-100 text-stone-700 px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 hover:text-primary-700 transition-colors border border-stone-200">
          Browse Daily Notes
        </a>
      </div>
    </div>
  </div>
</Layout>