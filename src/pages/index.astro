---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Daily Bible readings with linked verse pages - Man of God Daily Readings">
  <div class="animate-fade-in">
    <section class="mb-12 md:mb-16">
      <div class="bg-gradient-to-br from-primary-600 to-primary-800 rounded-2xl p-8 md:p-12 text-white relative overflow-hidden">
        <div class="relative z-10 max-w-3xl">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-serif mb-6 leading-tight">
            Man of God Daily Readings
          </h1>
          <p class="text-xl md:text-2xl text-primary-100 mb-8 leading-relaxed font-light">
            Daily Bible reading notes with linked verse pages
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/daily" class="bg-white text-primary-700 px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors shadow-lg">
              Browse Daily Notes
            </a>
            <a href="/bible" class="bg-primary-700/20 text-white border border-primary-300 px-6 py-3 rounded-lg font-semibold hover:bg-primary-700/30 transition-colors">
              Explore Verse Pages
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-12 md:mb-16">
      <blockquote class="bg-amber-50 border-l-4 border-amber-400 p-6 md:p-8 rounded-r-xl relative">
        <p class="text-2xl md:text-3xl font-serif text-amber-900 leading-relaxed mb-4">
          "Not by might, nor by power, but by my Spirit, says the Lord of hosts."
        </p>
        <footer class="text-amber-700 font-medium">
          — <cite class="font-serif not-italic">Zechariah 4:6</cite>
        </footer>
      </blockquote>
    </section>

    <section class="mb-12 md:mb-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-shadow animate-slide-up">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-stone-900">3</p>
              <p class="text-stone-600 text-sm">Daily Notes</p>
            </div>
          </div>
        </article>
        
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-shadow animate-slide-up">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-stone-900">51</p>
              <p class="text-stone-600 text-sm">Verse Pages</p>
            </div>
          </div>
        </article>
        
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-shadow animate-slide-up">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-stone-900">18</p>
              <p class="text-stone-600 text-sm">Bible Books</p>
            </div>
          </div>
        </article>
        
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-shadow animate-slide-up">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-stone-900">12</p>
              <p class="text-stone-600 text-sm">Topics</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="mb-12 md:mb-16">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900">Recent Daily Notes</h2>
        <a href="/daily" class="text-primary-700 hover:text-primary-800 font-medium text-sm flex items-center gap-1">
          View all <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <time class="text-sm text-primary-700 font-medium" datetime="2026-09-26">
            Saturday, September 26, 2026
          </time>
          <h3 class="mt-2 text-xl font-semibold text-stone-900 mb-3">
            <a href="/daily/2026-09-26-unexpected-opportunities" class="hover:text-primary-700 transition-colors">
              Unexpected Opportunities
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-4 line-clamp-2">
            Daily reading with Zechariah 8-9, Acts 23-24, Job 30...
          </p>
        </article>
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <time class="text-sm text-primary-700 font-medium" datetime="2026-09-25">
            Friday, September 25, 2026
          </time>
          <h3 class="mt-2 text-xl font-semibold text-stone-900 mb-3">
            <a href="/daily/2026-09-25-visions-revelations-and-questions" class="hover:text-primary-700 transition-colors">
              Visions, Revelations, and Questions
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-4 line-clamp-2">
            Daily reading with Zechariah 6-7, Acts 22-23, Job 29...
          </p>
        </article>
        <article class="bg-white rounded-xl p-6 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <time class="text-sm text-primary-700 font-medium" datetime="2026-09-24">
            Thursday, September 24, 2026
          </time>
          <h3 class="mt-2 text-xl font-semibold text-stone-900 mb-3">
            <a href="/daily/2026-09-24-not-by-might-nor-by-power" class="hover:text-primary-700 transition-colors">
              Not by might, nor by power...
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-4 line-clamp-2">
            Daily reading with Zechariah 4:6-7 and cross-references...
          </p>
        </article>
      </div>
    </section>

    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900">Recent Verse Pages</h2>
        <a href="/bible" class="text-primary-700 hover:text-primary-800 font-medium text-sm flex items-center gap-1">
          View all <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <article class="bg-white rounded-xl p-5 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <h3 class="font-semibold text-stone-900 mb-2">
            <a href="/bible/zechariah/8-v-1-23" class="hover:text-primary-700 transition-colors">
              Zechariah 8 v 1–23
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-3 line-clamp-2">
            The word of Yahweh of Armies came to me...
          </p>
        </article>
        <article class="bg-white rounded-xl p-5 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <h3 class="font-semibold text-stone-900 mb-2">
            <a href="/bible/zechariah/9-v-9" class="hover:text-primary-700 transition-colors">
              Zechariah 9 v 9
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-3 line-clamp-2">
            Rejoice greatly, daughter of Zion! Shout, daughter of Jerusalem! Behold, your King comes to you! He is righteous...
          </p>
        </article>
        <article class="bg-white rounded-xl p-5 shadow-sm border border-stone-200 hover:shadow-md transition-all hover:-translate-y-1">
          <h3 class="font-semibold text-stone-900 mb-2">
            <a href="/bible/acts/23-v-23-35" class="hover:text-primary-700 transition-colors">
              Acts 23 v 23–35
            </a>
          </h3>
          <p class="text-stone-600 text-sm mb-3 line-clamp-2">
            He called to himself two of the centurions, and said, Prepare two hundred soldiers...
          </p>
        </article>
      </div>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold text-stone-900 mb-6">Explore by Book</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
        <a href="/books/zechariah" class="bg-white rounded-lg p-4 text-center shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">
          <span class="font-medium text-stone-900 group-hover:text-primary-700 transition-colors">Zechariah</span>
          <span class="block text-xs text-stone-500 mt-1">21 passages</span>
        </a>
        <a href="/books/acts" class="bg-white rounded-lg p-4 text-center shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">
          <span class="font-medium text-stone-900 group-hover:text-primary-700 transition-colors">Acts</span>
          <span class="block text-xs text-stone-500 mt-1">7 passages</span>
        </a>
        <a href="/books/job" class="bg-white rounded-lg p-4 text-center shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">
          <span class="font-medium text-stone-900 group-hover:text-primary-700 transition-colors">Job</span>
          <span class="block text-xs text-stone-500 mt-1">2 passages</span>
        </a>
        <a href="/books/haggai" class="bg-white rounded-lg p-4 text-center shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">
          <span class="font-medium text-stone-900 group-hover:text-primary-700 transition-colors">Haggai</span>
          <span class="block text-xs text-stone-500 mt-1">5 passages</span>
        </a>
        <a href="/books/ezra" class="bg-white rounded-lg p-4 text-center shadow-sm border border-stone-200 hover:shadow-md hover:border-primary-300 hover:-translate-y-1 transition-all group">
          <span class="font-medium text-stone-900 group-hover:text-primary-700 transition-colors">Ezra</span>
          <span class="block text-xs text-stone-500 mt-1">3 passages</span>
        </a>
      </div>
    </section>
  </div>
</Layout>